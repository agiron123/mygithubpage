---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import '../styles/main.scss';

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/main.scss" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles/styles.css">
  </head>
  <body>
    <Header />
    <div class="page-content">
      <div class="wrapper">
        <slot />
      </div>
    </div>
    <Footer />
    <script is:inline src="https://code.jquery.com/jquery.js"></script>
    <script is:inline src="/scripts/bootstrap.min.js"></script>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=UA-141608400-1" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'UA-141608400-1');
    </script>
  </body>
</html>