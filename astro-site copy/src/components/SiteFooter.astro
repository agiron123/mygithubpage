---
import { siteConfig } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner footer-columns">
    <section>
      <h2 class="footer-text">{siteConfig.title}</h2>
      <p class="footer-text">{siteConfig.description}</p>
    </section>
    <section>
      <h3 class="footer-text">Contact</h3>
      <p>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      </p>
    </section>
    <section>
      <h3 class="footer-text">Around the web</h3>
      <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem;">
        {siteConfig.socials.github && (
          <li>
            <a href={`https://github.com/${siteConfig.socials.github}`}>
              GitHub - {siteConfig.socials.github}
            </a>
          </li>
        )}
        {siteConfig.socials.twitter && (
          <li>
            <a href={`https://twitter.com/${siteConfig.socials.twitter}`}>
              Twitter - @{siteConfig.socials.twitter}
            </a>
          </li>
        )}
      </ul>
    </section>
  </div>
  <div class="inner" style="text-align: center; padding-top: 0;">
    <small class="footer-text">(c) {year} {siteConfig.title}</small>
  </div>
</footer>
