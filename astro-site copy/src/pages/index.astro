import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Andre S. Giron"
  description="Hi there! I'm Andre - web and mobile software engineer."
  currentPath="/"
>
  <main>
    <section class="content-text" style="text-align: center;">
      <img
        src="/assets/images/profile_pic.png"
        alt="Andre Giron"
        width="225"
        height="225"
        class="title-pic"
      />
      <h2>Hi there! I'm Andre!</h2>
      <h3>I enjoy writing software and the creative freedom it brings.</h3>
      <h3>I'm a front-end web developer who thinks back-end is cool too.</h3>
      <h3>
        Most of my code lives on <a href="https://github.com/agiron123">GitHub.</a>
      </h3>
      <h3>
        I like teaching too, and have taught many through
        <a href="https://www.youtube.com/channel/UCu-1mg2TxEZMdkg2rqZBB0Q">
          screencasts
        </a>
        .
      </h3>
    </section>
  </main>
</BaseLayout>
