---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
---

<BaseLayout title="Contact | Andre S. Giron" description="Get in touch with Andre." currentPath="/contact">
  <main>
    <article class="post-article">
      <h1>Contact Information</h1>
      <p>Have something you would like to talk about? I'm all ears. Drop me a line at:</p>
      <p>
        <strong>Email:</strong>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      </p>
      <p>
        <strong>GitHub:</strong>
        <a href={`https://github.com/${siteConfig.socials.github}`}>
          github.com/{siteConfig.socials.github}
        </a>
      </p>
    </article>
  </main>
</BaseLayout>
