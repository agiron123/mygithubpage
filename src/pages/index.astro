---
import { Image } from "astro:assets";
import Blocks from "../components/Blocks.astro";
import { homeStatements, homeSummary, homeTitle } from "../agent/documents.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site";

const profileImage =
  "https://s.gravatar.com/avatar/bdde06829b728c2c9ca7b282e4969337?s=225";
---

<BaseLayout title={SITE.title}>
  <div class="home-page">
    <Image
      class="img-circle title-pic"
      src={profileImage}
      alt="Andre Giron"
      width={225}
      height={225}
      format="webp"
      loading="eager"
    />
    <h1>{homeTitle}</h1>
    <div class="content-text">
      {
        homeStatements.map((statement) => (
          <h2>
            <Blocks inlines={statement} />
          </h2>
        ))
      }
    </div>
    <div class="home-summary">
      <Blocks blocks={homeSummary} />
    </div>
  </div>
</BaseLayout>
