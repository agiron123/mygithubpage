---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../site";
import { Image } from "astro:assets";

const profileImage =
  "https://s.gravatar.com/avatar/bdde06829b728c2c9ca7b282e4969337?s=225";
---

<BaseLayout title={SITE.title}>
  <div class="home-page">
    <Image
      class="img-circle title-pic"
      src={profileImage}
      alt="Andre Giron"
      width={225}
      height={225}
      format="webp"
      loading="eager"
    />
    <h2>Hi there! I'm Andre!</h2>
    <div class="content-text">
      <h3>I enjoy writing software and the creative freedom it brings.</h3>
      <h3>I'm a front-end web developer who thinks back-end is cool too.</h3>
      <h3>
        Most of my code lives on&nbsp;<a href="https://github.com/agiron123"
          >Github.</a
        >
      </h3>
      <h3>
        I like teaching too, and have taught many through&nbsp;
        <a href="https://www.youtube.com/channel/UCu-1mg2TxEZMdkg2rqZBB0Q"
          >Screencasts.</a
        >
      </h3>
    </div>
  </div>
</BaseLayout>
